><Y>-2.275</Y><Z>0</Z><R00>1.0</R00><R01>-0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>-0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282075744</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">0</float><token name="Material">272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX975"><Properties><string name="Name">LeftFoot</string><Vector3 name="size"><X>0.94</X><Y>0.28</Y><Z>1.2</Z></Vector3><CoordinateFrame name="CFrame"><X>-0.55</X><Y>-3.04</Y><Z>-0.12</Z><R00>1.0</R00><R01>-0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>-0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4292006874</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">0</float><token name="Material">272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX976"><Properties><string name="Name">RightFoot</string><Vector3 name="size"><X>0.94</X><Y>0.28</Y><Z>1.2</Z></Vector3><CoordinateFrame name="CFrame"><X>0.55</X><Y>-3.04</Y><Z>-0.12</Z><R00>1.0</R00><R01>-0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>-0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4292006874</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">0</float><token name="Material">272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX977"><Properties><string name="Name">LeftForearm</string><Vector3 name="size"><X>0.72</X><Y>0.84</Y><Z>0.8</Z></Vector3><CoordinateFrame name="CFrame"><X>-1.36</X><Y>-0.37</Y><Z>0</Z><R00>1.0</R00><R01>-0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>-0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4285433508</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">0</float><token name="Material">272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX978"><Properties><string name="Name">RightForearm</string><Vector3 name="size"><X>0.72</X><Y>0.84</Y><Z>0.8</Z></Vector3><CoordinateFrame name="CFrame"><X>1.36</X><Y>-0.37</Y><Z>0</Z><R00>1.0</R00><R01>-0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>-0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4285433508</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">0</float><token name="Material">272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item></Item></Item><Item class="Folder" referent="RBX979"><Properties><string name="Name">OpeningRemotes</string></Properties><Item class="RemoteEvent" referent="RBX980"><Properties><string name="Name">Action</string></Properties></Item><Item class="RemoteEvent" referent="RBX981"><Properties><string name="Name">Update</string></Properties></Item></Item><Item class="Folder" referent="RBX982"><Properties><string name="Name">OpeningShared</string></Properties><Item class="ModuleScript" referent="RBX983"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- Opening prototype. No game title is assigned.
return {
    MinimumBedtime = 9,
    DreamTimeout = 90,
    CorruptionDelay = 45,
    CorruptionDuration = 38,
    NavigationCorruptionCap = .65,
    GroundY = 8,
    RecoveryFreeze = .35,
    RecoveryControlDelay = .65,
    DreamStartZ = -240,
    DreamEndZ = -448,
    EyeDelay = 3.5,
    EyeVanishDelay = 11,
    GetUpDuration = 3.6,
    NewsDuration = 25,
    ToastDuration = 4,
    CarMaxSpeed = 30,
    CarAcceleration = 13,
    CarBrake = 24,
    CarTurnRate = 1.25,
    RoadMinX = -17,
    RoadMaxX = 17,
    RoadMinZ = 51,
    RoadMaxZ = 374,
    Orders = {
        { name = "Burger meal", items = { "burger", "fries", "drink" } },
        { name = "Lunch to go", items = { "burger", "drink" } },
        { name = "Last order", items = { "fries", "burger" } },
    },
    News = {
        "Good morning. Police are investigating the deaths of two local residents found in their beds overnight.",
        "Both appeared to have died in their sleep. Investigators reported multiple cuts across their backs.",
        "Authorities also confirmed that both victims' eyes had been removed. No suspect has been identified.",
        "The circumstances remain unexplained. Police are asking anyone with information to come forward.",
    },
    WalkSpeed = 14,
    JumpPower = 50,
    -- Roblox Creator Store / APM music. See AUDIO-CREDITS.md.
    Sounds = {
        Room = "rbxassetid://1837256134",
        Dream = "rbxassetid://9044720271",
        Drone = "rbxassetid://9044720271",
        Wake = "rbxassetid://9038125533",
    },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX984"><Properties><string name="Name">State</string><ProtectedString name="Source">local State = {}
local function clamp(v,lo,hi) return math.max(lo,math.min(hi,v)) end
local function set(s,phase,now) s.phase=phase; s.startedAt=now; return phase end
function State.new(now)
    return {phase="ready",startedAt=now,dreamAt=0,corruption=0,furthest=0,lights={},checkpoint=1,
        completed=false,lampAt=-100,recoveringUntil=0,recoverySerial=0,portalAt=-100,
        breakfast="bread",toastAt=0,order=1,job="take",tray={},cleaned={},driving=nil}
end
function State.begin(s,now)
    if s.phase~="ready" and s.phase~="complete" then return false end
    local fresh=State.new(now); fresh.recoverySerial=s.recoverySerial+1
    for k in pairs(s) do s[k]=nil end
    for k,v in pairs(fresh) do s[k]=v end
    set(s,"bedtime",now); return true
end
function State.enterDream(s,now,c)
    if s.phase~="bedtime" or now-s.startedAt&lt;c.MinimumBedtime then return false end
    set(s,"dream",now); s.dreamAt=now; return true
end
function State.collect(s,index)
    if type(index)~="number" or index&lt;1 or index&gt;6 or index%1~=0 then return false end
    if s.phase~="dream" or s.lights[index] then return false end
    s.lights[index]=true; return true
end
function State.tick(s,now,progress,c)
    if s.phase=="dream" then
        s.furthest=math.max(s.furthest,clamp(progress,0,1))
        -- No location, interaction or portal can bypass the quiet first 45 seconds.
        local elapsed=now-s.dreamAt
        local timed=clamp((elapsed-c.CorruptionDelay)/c.CorruptionDuration,0,1)
        s.corruption=math.min(c.NavigationCorruptionCap,timed*c.NavigationCorruptionCap)
        if elapsed&gt;=c.DreamTimeout then return set(s,"blackout",now) end
    elseif s.phase=="blackout" and now-s.startedAt&gt;=2.2 then
        return set(s,"awake",now)
    elseif s.phase=="awake" and now-s.startedAt&gt;=c.EyeVanishDelay then
        return set(s,"lightsOut",now)
    elseif s.phase=="news" and now-s.startedAt&gt;=c.NewsDuration then
        return set(s,"breakfast",now)
    elseif s.phase=="breakfast" and s.breakfast=="toasting" and now-s.toastAt&gt;=c.ToastDuration then
        s.breakfast="eat"; return "breakfastUpdate"
    end
    return nil
end
-- Doors belong to the dream. Only its timer wakes the player.
function State.exit() return false end
function State.lamp(s,now)
    if s.phase~="lightsOut" or now-s.startedAt&lt;1 or now-s.lampAt&lt;1.6 then return false end
    s.lampAt=now; set(s,"getup",now); return true
end
function State.stand(s,now,c)
    if s.phase~="getup" or now-s.startedAt&lt;c.GetUpDuration then return false end
    set(s,"morning",now); return true
end
function State.recover(s,now,c)
    if s.phase~="dream" or now&lt;s.recoveringUntil then return false end
    s.recoverySerial=s.recoverySerial+1
    s.recoveringUntil=now+c.RecoveryControlDelay+.3
    return s.recoverySerial
end
function State.portal(s,now)
    if s.phase~="dream" or now-s.portalAt&lt;1.5 then return false end
    s.portalAt=now; return true
end
function State.interact(s,kind,now,c)
    if kind=="tv" and s.phase=="morning" then set(s,"news",now); return true
    elseif kind=="fridge" and s.phase=="breakfast" and s.breakfast=="bread" then
        s.breakfast="toast"; return true
    elseif kind=="toaster" and s.phase=="breakfast" and s.breakfast=="toast" then
        s.breakfast="toasting"; s.toastAt=now; return true
    elseif kind=="eat" and s.phase=="breakfast" and s.breakfast=="eat" then
        set(s,"leave",now); return true
    elseif kind=="carHome" and s.phase=="leave" then set(s,"driveWork",now); return true
    elseif kind=="carWork" and s.phase=="return" then set(s,"driveHome",now); return true
    elseif kind=="bed" and s.phase=="home" then set(s,"secondBedtime",now); return true
    end
    if s.phase=="work" then
        local order=c.Orders[s.order]
        if kind=="order" and s.job=="take" then s.job="prepare"; s.tray={}; return true end
        if s.job=="prepare" then
            for _,food in ipairs(order.items) do
                if kind==food and not s.tray[food] then s.tray[food]=true; return true end
            end
            if kind=="serve" then
                for _,food in ipairs(order.items) do if not s.tray[food] then return false end end
                if s.order&gt;=#c.Orders then set(s,"cleanup",now)
                else s.order=s.order+1; s.job="take"; s.tray={} end
                return true
            end
        end
    elseif s.phase=="cleanup" and (kind=="counter" or kind=="trash") and not s.cleaned[kind] then
        s.cleaned[kind]=true
        if s.cleaned.counter and s.cleaned.trash then set(s,"return",now) end
        return true
    end
    return false
end
function State.arrive(s,now)
    if s.phase=="driveWork" then s.driving=nil; set(s,"work",now); return true
    elseif s.phase=="driveHome" then s.driving=nil; set(s,"home",now); return true end
    return false
end
function State.finish(s,now,c)
    if s.phase~="secondBedtime" or now-s.startedAt&lt;c.MinimumBedtime then return false end
    s.completed=true; set(s,"complete",now); return true
end
function State.objective(s,c)
    local goals={
        dream="Explore the dream. Touch the things that feel familiar.",
        awake="Stay still. Watch the closet.",
        lightsOut="The red light is gone. Turn on the bedside lamp [E].",
        getup="Get out of bed.",
        morning="Sit on the couch and turn on the TV.",
        news="Watch the morning news.",
        leave="Go outside and get into your car.",
        driveWork="Drive up the road to work. Slow down and park [E].",
        driveHome="Drive back home. Slow down and park [E].",
        ["return"]="Your shift is over. Get in the car outside.",
        home="Go inside. Return to your bed.",
        secondBedtime="It's been a long day.",
        complete="Day one complete.",
    }
    if s.phase=="breakfast" then return ({
        bread="Breakfast: open the fridge and take the bread.",
        toast="Put the bread in the toaster.",
        toasting="Wait for the toast. The kitchen is quiet.",
        eat="Eat the toast on the counter.",
    })[s.breakfast] end
    if s.phase=="work" then
        if s.job=="take" then return "Order "..s.order.."/"..#c.Orders..": greet the customer at the register." end
        local missing={}
        for _,food in ipairs(c.Orders[s.order].items) do if not s.tray[food] then table.insert(missing,food) end end
        if #missing==0 then return "Order "..s.order..": take the tray to the pickup counter." end
        return "Order "..s.order..": prepare "..table.concat(missing,", ").."."
    end
    if s.phase=="cleanup" then
        if not s.cleaned.counter then return "Close the shift: wipe the counter." end
        return "Close the shift: empty the trash."
    end
    return goals[s.phase] or ""
end
function State.promptEnabled(s,kind,c)
    if kind=="tv" then return s.phase=="morning"
    elseif kind=="fridge" then return s.phase=="breakfast" and s.breakfast=="bread"
    elseif kind=="toaster" then return s.phase=="breakfast" and s.breakfast=="toast"
    elseif kind=="eat" then return s.phase=="breakfast" and s.breakfast=="eat"
    elseif kind=="carHome" then return s.phase=="leave"
    elseif kind=="carWork" then return s.phase=="return"
    elseif kind=="bed" then return s.phase=="home"
    elseif kind=="order" then return s.phase=="work" and s.job=="take"
    elseif kind=="serve" then
        if s.phase~="work" or s.job~="prepare" then return false end
        for _,food in ipairs(c.Orders[s.order].items) do if not s.tray[food] then return false end end
        return true
    elseif kind=="counter" or kind=="trash" then return s.phase=="cleanup" and not s.cleaned[kind] end
    if s.phase=="work" and s.job=="prepare" and not s.tray[kind] then
        for _,food in ipairs(c.Orders[s.order].items) do if kind==food then return true end end
    end
    return false
end
return State
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX985"><Properties><string name="Name">Navigation</string><ProtectedString name="Source">-- Pure numerical helpers; the server performs the actual ground raycast.
local Navigation = {}
function Navigation.clearance(hipHeight, rootHeight, legHeight)
    return math.max(3.8, math.max(0, hipHeight) + rootHeight * .5 + .8,
        rootHeight * .5 + math.max(0, legHeight) + .8)
end
function Navigation.needsRecovery(x, y, z, floorY)
    return x ~= x or y ~= y or z ~= z or y &lt; floorY - 5
        or math.abs(x) &gt; 86 or z &gt; -184 or z &lt; -500
end
function Navigation.checkpoint(current, candidate)
    return math.max(current, candidate)
end
return Navigation
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX986"><Properties><string name="Name">Driving</string><ProtectedString name="Source">-- Server-owned arcade driving, on a continuous road. No fragile wheel constraints.
local Driving = {}
local function clamp(n,a,b) return math.max(a,math.min(b,n)) end
function Driving.new(x,z,yaw,now)
    return {x=x,z=z,yaw=yaw,speed=0,throttle=0,steer=0,inputAt=now,startedAt=now,distance=0}
end
function Driving.input(car,throttle,steer,now)
    if type(throttle)~="number" or type(steer)~="number" or throttle~=throttle or steer~=steer
        or math.abs(throttle)&gt;1 or math.abs(steer)&gt;1 then return false end
    car.throttle=throttle; car.steer=steer; car.inputAt=now; return true
end
function Driving.tick(car,dt,now,c)
    dt=clamp(dt,0,.1)
    local throttle=now-car.inputAt&lt;.5 and car.throttle or 0
    local steer=now-car.inputAt&lt;.5 and car.steer or 0
    local target=throttle*c.CarMaxSpeed
    if throttle&lt;0 then target=throttle*10 end
    local rate=throttle==0 and c.CarBrake or c.CarAcceleration
    car.speed=car.speed+clamp(target-car.speed,-rate*dt,rate*dt)
    car.yaw=car.yaw-steer*c.CarTurnRate*dt*clamp(car.speed/12,-1,1)
    local dx=-math.sin(car.yaw)*car.speed*dt
    local dz=-math.cos(car.yaw)*car.speed*dt
    local x,z=car.x+dx,car.z+dz
    car.x=clamp(x,c.RoadMinX,c.RoadMaxX); car.z=clamp(z,c.RoadMinZ,c.RoadMaxZ)
    if x~=car.x or z~=car.z then car.speed=0 end
    car.distance=car.distance+math.sqrt((car.x-(x-dx))^2+(car.z-(z-dz))^2)
end
function Driving.canPark(car,x,z,now)
    return now-car.startedAt&gt;=3 and car.distance&gt;=30 and math.abs(car.speed)&lt;8
        and (car.x-x)^2+(car.z-z)^2&lt;=14^2
end
return Driving
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX987"><Properties><string name="Name">ActorAnimator</string><ProtectedString name="Source">-- A segmented cinematic actor: feet plant, knees bend, arms reach, and breathing remains subtle.
local Animator = {}
Animator.__index = Animator
function Animator.new(model)
    local self = setmetatable({ model = model, parts = {}, offsets = {} }, Animator)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then self.parts[part.Name] = part; self.offsets[part.Name] = model:GetPivot():ToObjectSpace(part.CFrame) end
    end
    return self
end
local function blend(a,b,t) return a + (b-a)*t end
function Animator:apply(pivot, time, pose)
    local p = self.parts; if not p.Root then return end
    local sit = pose.sit or 0; local walk = pose.walk or 0; local sleep = pose.sleep or 0
    local step = math.sin(time * 8.4) * walk
    local bob = math.abs(math.sin(time * 8.4)) * walk * .035
    local root = pivot * CFrame.new(0,bob,0)
    for name, part in pairs(p) do part.CFrame = root * self.offsets[name] end
    p.Root.CFrame = root
    local body = root * CFrame.Angles((pose.lean or 0) * .16, 0, 0)
    p.Torso.CFrame = body * self.offsets.Torso
    local breath = sleep * math.sin(time * 1.6) * .015
    -- Raise the back of the sleeping head onto the pillow rather than through it.
    local head = body * self.offsets.Head * CFrame.new(0,breath,-sleep*.32) * CFrame.Angles(0,(pose.look or 0)*.12,0)
    p.Head.CFrame = head
    for _, name in ipairs({"Hair","FaceEyeL","FaceEyeR","Mouth"}) do
        p[name].CFrame = head * self.offsets.Head:Inverse() * self.offsets[name]
    end
    local shut = pose.eyes or 0
    p.FaceEyeL.Size = Vector3.new(.13, blend(.13,.025,shut),.055)
    p.FaceEyeR.Size = p.FaceEyeL.Size
    for _, side in ipairs({-1,1}) do
        local leg = side &lt; 0 and "Left" or "Right"
        local hipAngle = sit * math.pi/2 + step * .43 * side * (1-sit)
        local kneeAngle = -sit * math.pi/2 - math.max(0,-step*side)*.24*(1-sit)
        local hip = body * CFrame.new(side*.55,-.5,0) * CFrame.Angles(hipAngle,0,0)
        p[leg.."Leg"].CFrame = hip * CFrame.new(0,-.575,0)
        local knee = hip * CFrame.new(0,-1.15,0) * CFrame.Angles(kneeAngle,0,0)
        p[leg.."LowerLeg"].CFrame = knee * CFrame.new(0,-.625,0)
        p[leg.."Foot"].CFrame = knee * CFrame.new(0,-1.39,-.12)
        local shoulder = body * CFrame.new(side*1.36,1.15,0)
        local angle = -step*.23*side + sit*.22
        local upper = shoulder * CFrame.Angles(angle,0,side*-.03)
        p[leg.."Arm"].CFrame = upper * CFrame.new(0,-.55,0)
        local elbow = upper * CFrame.new(0,-1.1,0) * CFrame.Angles(-.12-sit*.35,0,0)
        p[leg.."Forearm"].CFrame = elbow * CFrame.new(0,-.42,0)
        p[leg.."Hand"].CFrame = elbow * CFrame.new(0,-.97,0)
    end
    if pose.reach and pose.reach &gt; 0 and pose.target then
        local shoulder = (body * CFrame.new(1.36,1.15,0)).Position
        local ordinary = p.RightHand.Position
        local target = ordinary:Lerp(pose.target,pose.reach)
        local delta = target-shoulder; if delta.Magnitude &gt; 2.5 then target=shoulder+delta.Unit*2.5 end
        local elbow = shoulder:Lerp(target,.52) + body.RightVector*.12 + body.UpVector*.13
        local function bone(part,a,b)
            part.Size = Vector3.new(part.Size.X,(b-a).Magnitude,part.Size.Z)
            part.CFrame = CFrame.lookAt((a+b)*.5,b) * CFrame.Angles(math.pi/2,0,0)
        end
        bone(p.RightArm,shoulder,elbow); bone(p.RightForearm,elbow,target)
        p.RightHand.CFrame = CFrame.new(target) * root.Rotation
    else
        p.RightArm.Size = Vector3.new(.85,1.1,.9); p.RightForearm.Size=Vector3.new(.72,.84,.8)
    end
end
return Animator
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX988"><Properties><string name="Name">Music</string><ProtectedString name="Source">local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local Music = {}; Music.__index = Music
function Music.new(config)
    local self=setmetatable({sounds={},enabled=true,phase="ready",corruption=0},Music)
    for name,id in pairs(config.Sounds) do
        local s=Instance.new("Sound"); s.Name="OpeningMusic_"..name; s.SoundId=id
        s.Looped=name~="Wake"; s.Volume=0; s.Parent=SoundService; self.sounds[name]=s
        local reverb=Instance.new("ReverbSoundEffect"); reverb.DecayTime=name=="Room" and 1.8 or 3.5
        reverb.WetLevel=name=="Room" and -22 or -15; reverb.DryLevel=0; reverb.Parent=s
        local eq=Instance.new("EqualizerSoundEffect"); eq.Name="DreamFilter"; eq.Parent=s
        task.spawn(function()
            local ok=pcall(function() ContentProvider:PreloadAsync({s}) end)
            if not ok then warn("Opening audio unavailable: "..name..". Replace its Creator Store ID in Config.") end
        end)
    end
    self.sounds.Room.PlaybackSpeed=.93; self.sounds.Drone.PlaybackSpeed=.46
    return self
end
function Music:setEnabled(enabled) self.enabled=enabled end
function Music:setPhase(phase)
    self.phase=phase
    if phase=="awake" then self.sounds.Wake.TimePosition=0; self.sounds.Wake.Volume=self.enabled and .16 or 0; self.sounds.Wake:Play() end
    for name,s in pairs(self.sounds) do if name~="Wake" and not s.IsPlaying then s:Play() end end
end
function Music:update(dt,corruption)
    self.corruption=corruption
    local dream=self.phase=="dream"
    local room=self.phase=="ready" or self.phase=="bedtime" or self.phase=="secondBedtime"
    local day=self.phase=="morning" or self.phase=="breakfast" or self.phase=="leave" or self.phase=="driveWork"
        or self.phase=="work" or self.phase=="cleanup" or self.phase=="return" or self.phase=="driveHome" or self.phase=="home"
    local volumes={Room=room and .12 or day and .055 or 0,Dream=dream and .24 or 0,
        Drone=(dream and math.max(0,corruption-.28)*.16) or (self.phase=="awake" and .075 or 0)}
    for name,target in pairs(volumes) do
        local s=self.sounds[name]; local desired=self.enabled and target or 0
        s.Volume=s.Volume+(desired-s.Volume)*math.min(1,dt*1.4)
    end
    if not self.enabled then self.sounds.Wake.Volume=0 end
    local s=self.sounds.Dream
    s.PlaybackSpeed=1-corruption*.17
    local eq=s:FindFirstChild("DreamFilter"); eq.HighGain=-corruption*12; eq.MidGain=-corruption*3
end
return Music
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX989"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX990"><Properties><string name="Name">OpeningServer</string><ProtectedString name="Source">local Players=game:GetService("Players")
Players.CharacterAutoLoads=false
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local shared=ReplicatedStorage:WaitForChild("OpeningShared")
local Config=require(shared:WaitForChild("Config"))
local State=require(shared:WaitForChild("State"))
local Navigation=require(shared:WaitForChild("Navigation"))
local Driving=require(shared:WaitForChild("Driving"))
local remotes=ReplicatedStorage:WaitForChild("OpeningRemotes")
local action,update=remotes:WaitForChild("Action"),remotes:WaitForChild("Update")
local map=workspace:WaitForChild("OpeningWorld")
local dream,markers,day=map:WaitForChild("Dream"),map:WaitForChild("Markers"),map:WaitForChild("Day")
local interactions=day:WaitForChild("Interactions")
local states,lastRequest,lastDrive,appearances={},{},{},{}
local free={dream=true,morning=true,breakfast=true,leave=true,work=true,cleanup=true,["return"]=true,home=true}
local messages={
    "The blanket feels like sunlight. You remember a room you have never seen.",
    "The clock has forgotten what comes after twelve.",
    "A hallway is growing inside this little door.",
    "A voice says: 'Don't hurry. You have time here.' Then the phone begins to purr.",
    "The stars stir like sugar. Something enormous swims beneath them.",
    "The lantern rises. For a moment, you remember how to fly.",
}
local rayParams=RaycastParams.new()
rayParams.FilterType=Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances={dream.Walkable,map.Bedroom.Floor,day.Kitchen.Floor,
    day.Street.Ground,day.Street.Road,day.Street.Sidewalk,day.Street.FrontPath,day.Restaurant.Floor}
local function parts(player)
    local char=player.Character
    if not char then return nil,nil end
    return char:FindFirstChild("HumanoidRootPart"),char:FindFirstChildOfClass("Humanoid")
end
local function visible(player,show)
    local char=player.Character; if not char then return end
    local saved=appearances[player] or {}; appearances[player]=saved
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            if saved[p]==nil then saved[p]=p.Transparency end
            p.Transparency=show and saved[p] or 1
        end
    end
end
local function packet(player)
    local s=states[player]; if not s then return end
    update:FireClient(player,"Phase",{phase=s.phase,corruption=s.corruption,memories=s.lights,
        completed=s.completed,recovering=math.max(0,s.recoveringUntil-os.clock()-.3),
        breakfast=s.breakfast,order=s.order,job=s.job,tray=s.tray,cleaned=s.cleaned,
        objective=State.objective(s,Config),dreamElapsed=s.phase=="dream" and os.clock()-s.dreamAt or 0,
        sceneElapsed=os.clock()-s.startedAt,driving=s.driving})
end
local function freeze(player,marker)
    local root,hum=parts(player)
    visible(player,false)
    if root then
        root.Anchored=true; root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
        root.CFrame=(marker or markers.RoomSpawn).CFrame
    end
    if hum then hum.Sit=false; hum.WalkSpeed=0; hum.UseJumpPower=true; hum.JumpPower=0; hum.AutoRotate=false; hum:Move(Vector3.zero) end
end
local function safeCFrame(player,marker)
    local root,hum=parts(player); if not root or not hum then return nil end
    local hit=workspace:Raycast(marker.Position+Vector3.new(0,14,0),Vector3.new(0,-48,0),rayParams)
    local ground=hit and hit.Position or Vector3.new(marker.Position.X,marker.Position.Y-4,marker.Position.Z)
    local leg=player.Character:FindFirstChild("Left Leg")
    local clear=Navigation.clearance(hum.HipHeight,root.Size.Y,leg and leg.Size.Y or 0)
    return CFrame.new(ground+Vector3.new(0,clear,0))*marker.CFrame.Rotation
end
local function placeOnGround(player,marker,stabilize)
    local root,hum=parts(player); local s=states[player]
    if not root or not hum or not s or hum.Health&lt;=0 then return false end
    local cf=safeCFrame(player,marker); if not cf then return false end
    pcall(function() root:SetNetworkOwner(nil) end)
    root.Anchored=true; root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
    hum.Sit=false; hum.PlatformStand=false; hum:Move(Vector3.zero)
    player.Character:PivotTo(cf); visible(player,true)
    hum.WalkSpeed=Config.WalkSpeed; hum.UseJumpPower=true; hum.JumpPower=Config.JumpPower; hum.AutoRotate=true
    local serial,phase=s.recoverySerial,s.phase
    local function release()
        if not root.Parent or states[player]~=s or not free[s.phase] or s.phase~=phase or serial~=s.recoverySerial then return end
        root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero; root.Anchored=false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        pcall(function() root:SetNetworkOwnershipAuto() end)
    end
    if stabilize then task.delay(Config.RecoveryFreeze,release) else release() end
    return true
end
local function recover(player,marker,message)
    local s=states[player]; if not s or not State.recover(s,os.clock(),Config) then return end
    if placeOnGround(player,marker,true) then
        update:FireClient(player,"Recovery",{duration=Config.RecoveryControlDelay})
        update:FireClient(player,"Text",{text=message or "Your feet find the ground again. There is no hurry."})
    end
end
local function change(player,oldPhase)
    local s=states[player]; local phase=s.phase
    if phase=="dream" then placeOnGround(player,markers.DreamSpawn,false)
    elseif phase=="morning" then placeOnGround(player,markers.MorningSpawn,false)
    elseif phase=="breakfast" and oldPhase=="news" then placeOnGround(player,markers.CouchStand,false)
    elseif phase=="work" and oldPhase=="driveWork" then placeOnGround(player,markers.WorkArrival,false)
    elseif phase=="home" and oldPhase=="driveHome" then placeOnGround(player,markers.HomeArrival,false)
    elseif phase=="driveWork" or phase=="driveHome" then
        local marker=phase=="driveWork" and markers.CarHome or markers.CarWork
        if not s.driving then s.driving=Driving.new(marker.Position.X,marker.Position.Z,phase=="driveWork" and math.pi or 0,os.clock()) end
        freeze(player,marker)
    elseif not free[phase] then freeze(player)
    end
    packet(player)
end
local loadPlayer
local function setupCharacter(player,char)
    local root=char:WaitForChild("HumanoidRootPart",20); local hum=char:WaitForChild("Humanoid",20)
    if not root or not hum or not states[player] then return end
    appearances[player]={}; visible(player,false)
    root.Anchored=true; hum.WalkSpeed=0; hum.JumpPower=0; hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
    char.DescendantAdded:Connect(function(p)
        local s=states[player]
        if p:IsA("BasePart") and s then
            appearances[player][p]=p.Transparency
            if not free[s.phase] then p.Transparency=1 end
        end
    end)
    hum.Died:Connect(function() task.delay(2,function() if states[player] then loadPlayer(player) end end) end)
end
loadPlayer=function(player)
    local s=states[player]; if not s or s.loading then return end
    s.loading=true
    task.spawn(function()
        local ok=pcall(function() player:LoadCharacterAsync() end)
        if states[player]~=s then return end
        s.loading=false
        if not ok then update:FireClient(player,"Text",{text="The character could not load. Rejoin to retry."}); return end
        if s.phase=="dream" then
            s.recoveringUntil=0
            recover(player,markers:FindFirstChild("Checkpoint"..s.checkpoint) or markers.DreamSpawn,
                "You remember where you were. Keep exploring."); packet(player)
        elseif free[s.phase] then
            local marker=(s.phase=="work" or s.phase=="cleanup" or s.phase=="return") and markers.WorkEntry
                or s.phase=="home" and markers.HomeArrival or markers.MorningSpawn
            placeOnGround(player,marker,false); packet(player)
        else change(player) end
    end)
end
local function added(player)
    if states[player] then return end
    states[player]=State.new(os.clock())
    player.CharacterAdded:Connect(function(char) setupCharacter(player,char) end)
    if player.Character then setupCharacter(player,player.Character); change(player) end
end
Players.PlayerAdded:Connect(added)
for _,player in ipairs(Players:GetPlayers()) do added(player) end
Players.PlayerRemoving:Connect(function(player) states[player]=nil; lastRequest[player]=nil; lastDrive[player]=nil; appearances[player]=nil end)
action.OnServerEvent:Connect(function(player,command,a,b)
    if type(command)~="string" then return end
    local s=states[player]; if not s then added(player); s=states[player] end
    local now=os.clock()
    -- Ready is idempotent and must never override a recovered checkpoint.
    if command=="Ready" then if not player.Character then loadPlayer(player) elseif not s.loading then packet(player) end; return end
    if command=="DriveInput" then
        if s.driving and now-(lastDrive[player] or -100)&gt;=.035 then lastDrive[player]=now; Driving.input(s.driving,a,b,now) end
        return
    end
    if now-(lastRequest[player] or -100)&lt;.1 then return end; lastRequest[player]=now
    local old=s.phase
    if command=="Begin" then
        local root,hum=parts(player)
        if root and hum and State.begin(s,now) then change(player,old) end
    elseif command=="EnterDream" and State.enterDream(s,now,Config) then change(player,old)
    elseif command=="Return" and s.phase=="dream" then
        recover(player,markers:FindFirstChild("Checkpoint"..s.checkpoint) or markers.DreamSpawn)
    elseif command=="Lamp" and State.lamp(s,now) then change(player,old)
    elseif command=="Stand" and State.stand(s,now,Config) then change(player,old)
    elseif command=="SleepAgain" and State.finish(s,now,Config) then change(player,old)
    elseif command=="Park" and s.driving then
        local target=s.phase=="driveWork" and markers.CarWork or markers.CarHome
        if Driving.canPark(s.driving,target.Position.X,target.Position.Z,now) and State.arrive(s,now) then change(player,old)
        else update:FireClient(player,"Text",{text="Stop inside the marked parking area, then press E to park."}) end
    end
end)
for i=1,6 do
    local index=i; local obj=dream:WaitForChild("Interaction"..i)
    obj:WaitForChild("Remember").Triggered:Connect(function(player)
        local s=states[player]; local root=parts(player)
        if not s or not root or s.phase~="dream" or (root.Position-obj.Position).Magnitude&gt;13 then return end
        if State.collect(s,index) then update:FireClient(player,"Memory",{index=index}); update:FireClient(player,"Text",{text=messages[index]}) end
        if index&gt;=4 then update:FireClient(player,"DreamInteraction",{index=index}) end
        if index==3 and State.portal(s,os.clock()) then recover(player,markers.HallwaySpawn,"The small door opens into a very long thought.") end
    end)
end
local function dreamPrompt(name,fn)
    local obj=dream:WaitForChild(name)
    obj:WaitForChild("Remember").Triggered:Connect(function(player)
        local s=states[player]; local root=parts(player)
        if s and root and s.phase=="dream" and (root.Position-obj.Position).Magnitude&lt;13 then fn(player,s) end
    end)
end
dreamPrompt("HallwayReturn",function(player,s)
    if State.portal(s,os.clock()) then recover(player,markers.PortalReturn,"The hallway lets you out somewhere else.") end
end)
dreamPrompt("ExitPrompt",function(player,s)
    update:FireClient(player,"Text",{text=s.corruption&gt;.25 and "Behind the door, someone is breathing in time with you." or "Beyond the door you can hear the ocean, although you are already standing in it."})
    if State.portal(s,os.clock()) then recover(player,markers.DreamSpawn,"You step through and find the beginning again.") end
end)
local foodLines={burger="The grill hisses. Burger ready.",fries="Golden fries, salted and packed.",drink="Ice, soda, lid. Ready to go.",counter="The counter is clean.",trash="The last bag goes into the bin."}
for _,obj in ipairs(interactions:GetChildren()) do
    local kind=obj.Name
    obj:WaitForChild("Use").Triggered:Connect(function(player)
        local s=states[player]; local root=parts(player)
        if not s or not root or (root.Position-obj.Position).Magnitude&gt;12 then return end
        if kind=="coworker" then
            if s.phase=="work" or s.phase=="cleanup" or s.phase=="return" then
                update:FireClient(player,"Text",{text="Coworker: You look exhausted. Grab some water after these orders. I'll lock up tonight."})
            end
            return
        end
        local now=os.clock(); local old=s.phase
        if not State.interact(s,kind,now,Config) then return end
        update:FireClient(player,"DayInteraction",{kind=kind})
        change(player,old)
        if kind=="order" then update:FireClient(player,"Text",{text="Customer: "..table.concat(Config.Orders[s.order].items,", ")..", please."})
        elseif kind=="serve" then update:FireClient(player,"Text",{text=s.phase=="cleanup" and "Last customer: Thanks. Hope you get some sleep tonight." or "Customer: Thank you!"})
        elseif foodLines[kind] then update:FireClient(player,"Text",{text=foodLines[kind]})
        elseif kind=="fridge" then update:FireClient(player,"Text",{text="Bread. Butter. Everything where you left it."})
        elseif kind=="eat" then update:FireClient(player,"Text",{text="Just a bad dream. I should get to work."}) end
    end)
end
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    local now=os.clock()
    for player,s in pairs(states) do
        if s.driving then
            Driving.tick(s.driving,dt,now,Config)
            local root=parts(player)
            if root then root.CFrame=CFrame.new(s.driving.x,2.3,s.driving.z)*CFrame.Angles(0,s.driving.yaw,0) end
        end
    end
    elapsed=elapsed+dt; if elapsed&lt;.15 then return end; elapsed=0
    for player,s in pairs(states) do
        local root,hum=parts(player)
        if root and hum and hum.Health&gt;0 then
            if s.phase=="dream" then
                if Navigation.needsRecovery(root.Position.X,root.Position.Y,root.Position.Z,Config.GroundY) then
                    recover(player,markers:FindFirstChild("Checkpoint"..s.checkpoint) or markers.DreamSpawn)
                end
                for i=1,8 do local cp=markers:FindFirstChild("Checkpoint"..i)
                    if cp and (root.Position-cp.Position).Magnitude&lt;18 then s.checkpoint=Navigation.checkpoint(s.checkpoint,i) end
                end
            elseif free[s.phase] and root.Position.Y &lt; -5 then
                placeOnGround(player,(s.phase=="work" or s.phase=="cleanup" or s.phase=="return") and markers.WorkEntry
                    or s.phase=="home" and markers.HomeArrival or markers.MorningSpawn,true)
            end
        end
        local old=s.phase
        local progress=root and (Config.DreamStartZ-root.Position.Z)/(Config.DreamStartZ-Config.DreamEndZ) or 0
        local changed=State.tick(s,now,progress,Config)
        if changed then change(player,old) end
        if s.phase=="getup" and now-s.startedAt&gt;10 and State.stand(s,now,Config) then change(player,old) end
        if s.phase=="dream" then update:FireClient(player,"Corruption",{value=s.corruption,elapsed=now-s.dreamAt})
        elseif s.driving then update:FireClient(player,"Drive",{x=s.driving.x,z=s.driving.z,yaw=s.driving.yaw,speed=s.driving.speed}) end
    end
end)
